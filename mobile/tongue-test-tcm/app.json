{
  "expo": {
    "name": "Tongue Test TCM",
    "slug": "tongue-test-tcm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/tongue-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F3EA"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tonguetesttcm.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Used to take a clear tongue photo for your educational TCM wellness report.",
        "NSPhotoLibraryUsageDescription": "Used to upload a tongue photo and save your educational wellness report.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.tonguetesttcm.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F3EA"
      }
    },
    "web": {
      "favicon": "./assets/adaptive-icon.png"
    },
    "plugins": [],
    "extra": {
      "eas": {
        "projectId": "replace-after-eas-init"
      }
    }
  }
}
